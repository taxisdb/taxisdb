^TBDR(260,"e.g. sys.attr.cardinality has range sys.val.ref and expected type sys.enum.cardinality, meaning its values must reference an instance of sys.enum.cardinality @en")="K104.0187D3"
^TBDR(260,"e.g. sys.cvt.height groups a magnitude field and a unit field as the fixed set of roles composing a height value @en")="K104.018815"
