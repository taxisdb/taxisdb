^TBEnts(241,"sys.attr.cardinality","sys.attr.cardinality")="sys.enum.cardinality.one"
^TBEnts(241,"sys.attr.cardinality","sys.attr.description")="Enumerated single-value attribute that defines whether another attribute holds one or many values @en"
^TBEnts(241,"sys.attr.cardinality","sys.attr.exptype")="sys.enum.cardinality"
^TBEnts(241,"sys.attr.cardinality","sys.attr.extid.code")=":db/cardinality"
^TBEnts(241,"sys.attr.cardinality","sys.attr.isa")="sys.type.attr"
^TBEnts(241,"sys.attr.cardinality","sys.attr.key")="sys.attr.cardinality"
^TBEnts(241,"sys.attr.cardinality","sys.attr.label")="Cardinality @en"
^TBEnts(241,"sys.attr.cardinality","sys.attr.name")="cardinality"
^TBEnts(241,"sys.attr.cardinality","sys.attr.range")="sys.val.ref"
^TBEnts(241,"sys.attr.cardinality","sys.attr.required")=1
^TBEnts(242,"sys.attr.unique","sys.attr.alias")="unq"
^TBEnts(242,"sys.attr.unique","sys.attr.cardinality")="sys.enum.cardinality.one"
^TBEnts(242,"sys.attr.unique","sys.attr.description")="Enumerated single-value attribute that defines the uniqueness constraint behavior applied to another attribute, determining whether values are inserted as unique entries or used to unify with existing entities based on identity matching. @en"
^TBEnts(242,"sys.attr.unique","sys.attr.exptype")="sys.enum.unique"
^TBEnts(242,"sys.attr.unique","sys.attr.extid.code")=":db/unique"
^TBEnts(242,"sys.attr.unique","sys.attr.isa")="sys.type.attr"
^TBEnts(242,"sys.attr.unique","sys.attr.key")="sys.attr.unique"
^TBEnts(242,"sys.attr.unique","sys.attr.label")="Unique @en"
^TBEnts(242,"sys.attr.unique","sys.attr.name")="unique"
^TBEnts(242,"sys.attr.unique","sys.attr.range")="sys.val.ref"
^TBEnts(242,"sys.attr.unique","sys.attr.required")=0
^TBEnts(244,"sys.attr.indexed","sys.attr.alias")="ndx"
^TBEnts(244,"sys.attr.indexed","sys.attr.cardinality")="sys.enum.cardinality.one"
^TBEnts(244,"sys.attr.indexed","sys.attr.description")="Atomic single-value attribute that defines whether another attribute is indexed. If true, attribute values are added to AVET index @en"
^TBEnts(244,"sys.attr.indexed","sys.attr.extid.code")=":db/index"
^TBEnts(244,"sys.attr.indexed","sys.attr.isa")="sys.type.attr"
^TBEnts(244,"sys.attr.indexed","sys.attr.key")="sys.attr.indexed"
^TBEnts(244,"sys.attr.indexed","sys.attr.label")="Indexed @en"
^TBEnts(244,"sys.attr.indexed","sys.attr.name")="indexed"
^TBEnts(244,"sys.attr.indexed","sys.attr.range")="sys.val.boolean"
^TBEnts(250,"sys.attr.name","sys.attr.alias")="name"
^TBEnts(250,"sys.attr.name","sys.attr.cardinality")="sys.enum.cardinality.one"
^TBEnts(250,"sys.attr.name","sys.attr.description")="Atomic single-value attribute that is the short human-readable identifier for the entity, forming the last segment of its dot-notated key. @en"
^TBEnts(250,"sys.attr.name","sys.attr.example")="e.g. a name of `claudio_arrau` yields `sandbox.obj.claudio_arrau`, `sandbox.person.claudio_arrau`, `sandbox.pianist.claudio_arrau` and so on. @en"
^TBEnts(250,"sys.attr.name","sys.attr.isa")="sys.type.attr"
^TBEnts(250,"sys.attr.name","sys.attr.key")="sys.attr.name"
^TBEnts(250,"sys.attr.name","sys.attr.label")="Name Attribute @en"
^TBEnts(250,"sys.attr.name","sys.attr.name")="name"
^TBEnts(250,"sys.attr.name","sys.attr.range")="sys.val.name"
^TBEnts(250,"sys.attr.name","sys.attr.usage")="It is used as the base from which synthetic fully-qualified names are derived across namespaces and types @en"
^TBEnts(251,"sys.attr.display","sys.attr.alias")="display"
^TBEnts(251,"sys.attr.display","sys.attr.cardinality")="sys.enum.cardinality.many"
^TBEnts(251,"sys.attr.display","sys.attr.description")="Atomic multi-value attribute that provides a generic, human-readable friendly display value for the entity @en"
^TBEnts(251,"sys.attr.display","sys.attr.example")="e.g. (lat -36.60664, lng -72.10344) @en"
^TBEnts(251,"sys.attr.display","sys.attr.isa")="sys.type.attr"
^TBEnts(251,"sys.attr.display","sys.attr.key")="sys.attr.display"
^TBEnts(251,"sys.attr.display","sys.attr.label")="Display Attribute Value @en"
^TBEnts(251,"sys.attr.display","sys.attr.name")="display"
^TBEnts(251,"sys.attr.display","sys.attr.range")="sys.val.string"
^TBEnts(251,"sys.attr.display","sys.attr.usage")="It is a single-value plain string attribute, not language tagged, intended for generic display purposes such as coordinate summaries or composite value previews @en"
^TBEnts(255,"sys.attr.alias","sys.attr.alias")="alias"
^TBEnts(255,"sys.attr.alias","sys.attr.cardinality")="sys.enum.cardinality.many"
^TBEnts(255,"sys.attr.alias","sys.attr.description")="Atomic multi-value attribute that assigns one or more alternative names to an object, enabling user-friendly, searchable, and easily memorable references to the same entity. @en"
^TBEnts(255,"sys.attr.alias","sys.attr.isa")="sys.type.attr"
^TBEnts(255,"sys.attr.alias","sys.attr.key")="sys.attr.alias"
^TBEnts(255,"sys.attr.alias","sys.attr.label")="Alias @en"
^TBEnts(255,"sys.attr.alias","sys.attr.name")="alias"
^TBEnts(255,"sys.attr.alias","sys.attr.range")="sys.val.alias"
^TBEnts(255,"sys.attr.alias","sys.attr.unique")="sys.enum.unique.upsert"
^TBEnts(260,"sys.attr.example","sys.attr.alias")="eg"
^TBEnts(260,"sys.attr.example","sys.attr.cardinality")="sys.enum.cardinality.many"
^TBEnts(260,"sys.attr.example","sys.attr.description")="Atomic multi-value attribute that stores one or more representative examples illustrating the typical use or expected values of the entity. @en"
^TBEnts(260,"sys.attr.example","sys.attr.example")="e.g. An example must always start with the prefix `e.g` @en"
^TBEnts(260,"sys.attr.example","sys.attr.isa")="sys.type.attr"
^TBEnts(260,"sys.attr.example","sys.attr.key")="sys.attr.example"
^TBEnts(260,"sys.attr.example","sys.attr.label")="Example @en"
^TBEnts(260,"sys.attr.example","sys.attr.name")="example"
^TBEnts(260,"sys.attr.example","sys.attr.range")="sys.val.langstr"
^TBEnts(260,"sys.attr.example","sys.attr.usage")="When you use an example, start with the prefix `e.g.` @en"
^TBEnts(262,"sys.attr.description","sys.attr.alias")="doc"
^TBEnts(262,"sys.attr.description","sys.attr.cardinality")="sys.enum.cardinality.many"
^TBEnts(262,"sys.attr.description","sys.attr.description")="Atomic multi-value attribute that stores a human-readable description of an object, potentially translated in other languages @en"
^TBEnts(262,"sys.attr.description","sys.attr.extid.code")=":db.type/doc"
^TBEnts(262,"sys.attr.description","sys.attr.isa")="sys.type.attr"
^TBEnts(262,"sys.attr.description","sys.attr.key")="sys.attr.description"
^TBEnts(262,"sys.attr.description","sys.attr.label")="Description @en"
^TBEnts(262,"sys.attr.description","sys.attr.name")="description"
^TBEnts(262,"sys.attr.description","sys.attr.range")="sys.val.langstr"
^TBEnts(267,"sys.attr.wikipage","sys.attr.alias")="wiki"
^TBEnts(267,"sys.attr.wikipage","sys.attr.cardinality")="sys.enum.cardinality.many"
^TBEnts(267,"sys.attr.wikipage","sys.attr.description")="The URL of a Wikipedia page that is related to an object @en"
^TBEnts(267,"sys.attr.wikipage","sys.attr.isa")="sys.type.attr"
^TBEnts(267,"sys.attr.wikipage","sys.attr.key")="sys.attr.wikipage"
^TBEnts(267,"sys.attr.wikipage","sys.attr.label")="Wikipage @en"
^TBEnts(267,"sys.attr.wikipage","sys.attr.name")="wikipage"
^TBEnts(267,"sys.attr.wikipage","sys.attr.range")="sys.val.url"
^TBEnts(267,"sys.attr.wikipage","sys.attr.unique")="sys.enum.unique.insert"
^TBEnts(267,"sys.attr.wikipage","sys.attr.usage")="Atomic multi-value attribute that is used to reference Wikipedia pages related to an object. @en"
^TBEnts(267,"sys.attr.wikipage","sys.attr.validationfn")="$$IsURL^utils"
^TBEnts(268,"sys.attr.homepage","sys.attr.alias")="home"
^TBEnts(268,"sys.attr.homepage","sys.attr.cardinality")="sys.enum.cardinality.one"
^TBEnts(268,"sys.attr.homepage","sys.attr.description")="The official website (homepage) of an object @en"
^TBEnts(268,"sys.attr.homepage","sys.attr.isa")="sys.type.attr"
^TBEnts(268,"sys.attr.homepage","sys.attr.key")="sys.attr.homepage"
^TBEnts(268,"sys.attr.homepage","sys.attr.label")="Official Website @en"
^TBEnts(268,"sys.attr.homepage","sys.attr.name")="homepage"
^TBEnts(268,"sys.attr.homepage","sys.attr.range")="sys.val.url"
^TBEnts(268,"sys.attr.homepage","sys.attr.unique")="sys.enum.unique.insert"
^TBEnts(268,"sys.attr.homepage","sys.attr.usage")="Atomic single-value attribute used to link an object to its primary official website on the internet. @en"
^TBEnts(268,"sys.attr.homepage","sys.attr.validationfn")="$$IsURL^utils"
^TBEnts(270,"sys.attr.extid.code","sys.attr.alias")="code"
^TBEnts(270,"sys.attr.extid.code","sys.attr.cardinality")="sys.enum.cardinality.many"
^TBEnts(270,"sys.attr.extid.code","sys.attr.description")="Atomic multi-value attribute that assigns an external identifier, vocabulary code to an object, linking it to a corresponding entity in an external database system. @en"
^TBEnts(270,"sys.attr.extid.code","sys.attr.isa")="sys.type.attr"
^TBEnts(270,"sys.attr.extid.code","sys.attr.key")="sys.attr.extid.code"
^TBEnts(270,"sys.attr.extid.code","sys.attr.label")="Code @en"
^TBEnts(270,"sys.attr.extid.code","sys.attr.name")="code"
^TBEnts(270,"sys.attr.extid.code","sys.attr.notes")="it will be replaced with an association of type b.ext.identifier @en"
^TBEnts(270,"sys.attr.extid.code","sys.attr.range")="sys.val.string"
^TBEnts(270,"sys.attr.extid.code","sys.attr.unique")="sys.enum.unique.insert"
^TBEnts(277,"sys.attr.id","sys.attr.alias")="id"
^TBEnts(277,"sys.attr.id","sys.attr.cardinality")="sys.enum.cardinality.one"
^TBEnts(277,"sys.attr.id","sys.attr.description")="Atomic single-value attribute that identifies an existing entity only by a persisted EID generated by GENID. @en"
^TBEnts(277,"sys.attr.id","sys.attr.isa")="sys.type.attr"
^TBEnts(277,"sys.attr.id","sys.attr.key")="sys.attr.id"
^TBEnts(277,"sys.attr.id","sys.attr.label")="ID @en"
^TBEnts(277,"sys.attr.id","sys.attr.name")="id"
^TBEnts(277,"sys.attr.id","sys.attr.notes")="Values of sys.attr.id are not registered in the value dictionary (^TBD/^TBDR). No valkey is allocated, no SingleValueUpsert is called, and no entry appears in globals @en"
^TBEnts(277,"sys.attr.id","sys.attr.range")="sys.val.string"
^TBEnts(277,"sys.attr.id","sys.attr.usage")="Use this attribute to identify the target entity in every Assert or Retract record. Supply a raw EID (120 characters). @en"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.alias")="rby"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.cardinality")="sys.enum.cardinality.one"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.description")="Atomic single-value attribute that identifies an entity by a unique-attribute that resolves to an existing EID. @en"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.isa")="sys.type.attr"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.key")="sys.attr.resolvedby"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.label")="Resolved By @en"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.name")="resolvedby"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.notes")="Values of sys.attr.resolvedby are not registered in the value dictionary (^TBD/^TBDR). No valkey is allocated, no SingleValueUpsert is called, and no entry appears in globals @en"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.range")="sys.val.keyword"
^TBEnts(279,"sys.attr.resolvedby","sys.attr.usage")="Use this attribute to resolve the target entity in every Assert or Retract record. Supply the attribute key of a UNQINSERT/UNQUPSERT attribute.  @en"
^TBEnts(280,"sys.attr.exptype","sys.attr.alias")="exptype"
^TBEnts(280,"sys.attr.exptype","sys.attr.cardinality")="sys.enum.cardinality.many"
^TBEnts(280,"sys.attr.exptype","sys.attr.description")="Atomic multi-value attribute that constrains a reference-typed attribute by specifying expected entity types of the referenced value. @en"
^TBEnts(280,"sys.attr.exptype","sys.attr.example")="e.g. sys.attr.cardinality has range sys.val.ref and expected type sys.enum.cardinality, meaning its values must reference an instance of sys.enum.cardinality @en"
^TBEnts(280,"sys.attr.exptype","sys.attr.isa")="sys.type.attr"
^TBEnts(280,"sys.attr.exptype","sys.attr.key")="sys.attr.exptype"
^TBEnts(280,"sys.attr.exptype","sys.attr.label")="Expected Type @en"
^TBEnts(280,"sys.attr.exptype","sys.attr.name")="exptype"
^TBEnts(280,"sys.attr.exptype","sys.attr.range")="sys.val.ref"
^TBEnts(280,"sys.attr.exptype","sys.attr.usage")="Use this attribute alongside sys.attr.range when the range is a reference type, to further restrict which entity type the reference must point to. @en"
^TBEnts(290,"sys.attr.notes","sys.attr.alias")="notes"
^TBEnts(290,"sys.attr.notes","sys.attr.cardinality")="sys.enum.cardinality.many"
^TBEnts(290,"sys.attr.notes","sys.attr.description")="Atomic multi-value attribute that allow storing multiple note values, each language-tagged. @en"
^TBEnts(290,"sys.attr.notes","sys.attr.isa")="sys.type.attr"
^TBEnts(290,"sys.attr.notes","sys.attr.key")="sys.attr.notes"
^TBEnts(290,"sys.attr.notes","sys.attr.label")="Notes @en"
^TBEnts(290,"sys.attr.notes","sys.attr.name")="notes"
^TBEnts(290,"sys.attr.notes","sys.attr.notes")="Attribute sys.attr.notes should be differentiated from sys.attr.description or sys.attr.usage. Description explains what an entity is; usage explains when and why it should be used. @en"
^TBEnts(290,"sys.attr.notes","sys.attr.range")="sys.val.langstr"
^TBEnts(290,"sys.attr.notes","sys.attr.usage")="Use notes for supplemental information, implementation details, caveats, historical context, or miscellaneous remarks @en"
^TBEnts(299,"sys.attr.isa","sys.attr.alias")="isa"
^TBEnts(299,"sys.attr.isa","sys.attr.cardinality")="sys.enum.cardinality.one"
^TBEnts(299,"sys.attr.isa","sys.attr.description")="Atomic single-value attribute that declares the type that this entity is an instance of @en"
^TBEnts(299,"sys.attr.isa","sys.attr.isa")="sys.type.attr"
^TBEnts(299,"sys.attr.isa","sys.attr.key")="sys.attr.isa"
^TBEnts(299,"sys.attr.isa","sys.attr.label")="Isa @en"
^TBEnts(299,"sys.attr.isa","sys.attr.name")="isa"
^TBEnts(299,"sys.attr.isa","sys.attr.range")="sys.val.ref"
^TBEnts(299,"sys.attr.isa","sys.attr.required")=1
^TBEnts(299,"sys.attr.isa","sys.attr.usage")="Notice that each entity belongs to only one entity type. Use an object to capture the multi-type nature of an entity @en"
^TBEnts(300,"sys.type.enum","sys.attr.alias")="ENUM"
^TBEnts(300,"sys.type.enum","sys.attr.description")="A meta-level concept type whose instances denote enumerated value types, each grouping a closed set of named constants used as the range of constrained attributes. @en"
^TBEnts(300,"sys.type.enum","sys.attr.example")="e.g. sys.enum.cardinality groups sys.enum.cardinality.one and sys.enum.cardinality.many as its closed set of constants @en"
^TBEnts(300,"sys.type.enum","sys.attr.isa")="sys.type.type"
^TBEnts(300,"sys.type.enum","sys.attr.key")="sys.type.enum"
^TBEnts(300,"sys.type.enum","sys.attr.label")="Enum Type @en"
^TBEnts(300,"sys.type.enum","sys.attr.name")="enum"
^TBEnts(300,"sys.type.enum","sys.attr.usage")="Use this entity type to create enumerated value types whose instances are the allowed constants. Do not use sys.type.val for enumerated types — use sys.type.enum instead. @en"
^TBEnts(310,"sys.enum.cardinality","sys.attr.alias")="CARDINALITY"
^TBEnts(310,"sys.enum.cardinality","sys.attr.description")="Enumerated value type representing the set of cardinality constraints used by `sys.attr.cardinality`. Valid instances are sys.enum.cardinality.one and sys.enum.cardinality.many. @en"
^TBEnts(310,"sys.enum.cardinality","sys.attr.example")="e.g. sys.enum.cardinality.one restricts an attribute to a single value; sys.enum.cardinality.many allows multiple values @en"
^TBEnts(310,"sys.enum.cardinality","sys.attr.isa")="sys.type.enum"
^TBEnts(310,"sys.enum.cardinality","sys.attr.key")="sys.enum.cardinality"
^TBEnts(310,"sys.enum.cardinality","sys.attr.label")="Cardinality Enumerated Type @en"
^TBEnts(310,"sys.enum.cardinality","sys.attr.name")="enum.cardinality"
^TBEnts(311,"sys.enum.cardinality.one","sys.attr.alias")="ONE"
^TBEnts(311,"sys.enum.cardinality.one","sys.attr.description")="A value representing a cardinality constraint used by `sys.attr.cardinality` to restrict an attribute to exactly one value. @en"
^TBEnts(311,"sys.enum.cardinality.one","sys.attr.extid.code")=":db.cardinality/one"
^TBEnts(311,"sys.enum.cardinality.one","sys.attr.isa")="sys.enum.cardinality"
^TBEnts(311,"sys.enum.cardinality.one","sys.attr.key")="sys.enum.cardinality.one"
^TBEnts(311,"sys.enum.cardinality.one","sys.attr.label")="One @en"
^TBEnts(311,"sys.enum.cardinality.one","sys.attr.name")="one"
^TBEnts(317,"sys.enum.cardinality.many","sys.attr.alias")="MANY"
^TBEnts(317,"sys.enum.cardinality.many","sys.attr.description")="A value representing a cardinality constraint used by `sys.attr.cardinality` to allow an attribute to hold multiple values. @en"
^TBEnts(317,"sys.enum.cardinality.many","sys.attr.extid.code")=":db.cardinality/many"
^TBEnts(317,"sys.enum.cardinality.many","sys.attr.isa")="sys.enum.cardinality"
^TBEnts(317,"sys.enum.cardinality.many","sys.attr.key")="sys.enum.cardinality.many"
^TBEnts(317,"sys.enum.cardinality.many","sys.attr.label")="Many @en"
^TBEnts(317,"sys.enum.cardinality.many","sys.attr.name")="many"
^TBEnts(380,"sys.enum.unique","sys.attr.alias")="UNIQUE"
^TBEnts(380,"sys.enum.unique","sys.attr.description")="Enumerated value type representing the set of uniqueness constraint used by `sys.attr.unique`. Valid instances are sys.enum.unique.insert and sys.enum.unique.upsert. @en"
^TBEnts(380,"sys.enum.unique","sys.attr.example")="e.g. sys.enum.unique.insert enforces uniqueness on insert only; sys.enum.unique.upsert unifies incoming data with an existing entity on match @en"
^TBEnts(380,"sys.enum.unique","sys.attr.isa")="sys.type.enum"
^TBEnts(380,"sys.enum.unique","sys.attr.key")="sys.enum.unique"
^TBEnts(380,"sys.enum.unique","sys.attr.label")="Unique Enumerated Type @en"
^TBEnts(380,"sys.enum.unique","sys.attr.name")="enum.unique"
^TBEnts(383,"sys.enum.unique.insert","sys.attr.alias")="UNQINSERT"
^TBEnts(383,"sys.enum.unique.insert","sys.attr.description")="A value representing a uniqueness constraint used by `sys.attr.unique` that enforces uniqueness of attribute values across entities, preventing duplicates during entity creation. @en"
^TBEnts(383,"sys.enum.unique.insert","sys.attr.extid.code")=":db.unique/value"
^TBEnts(383,"sys.enum.unique.insert","sys.attr.isa")="sys.enum.unique"
^TBEnts(383,"sys.enum.unique.insert","sys.attr.key")="sys.enum.unique.insert"
^TBEnts(383,"sys.enum.unique.insert","sys.attr.label")="Insert @en"
^TBEnts(383,"sys.enum.unique.insert","sys.attr.name")="insert"
^TBEnts(385,"sys.enum.unique.upsert","sys.attr.alias")="UNQUPSERT"
^TBEnts(385,"sys.enum.unique.upsert","sys.attr.description")="A value representing a uniqueness constraint used by `sys.attr.unique` that enables identity-based uniqueness, implementing upsert semantics (insert or update depending on existence). @en"
^TBEnts(385,"sys.enum.unique.upsert","sys.attr.extid.code")=":db.unique/identity"
^TBEnts(385,"sys.enum.unique.upsert","sys.attr.isa")="sys.enum.unique"
^TBEnts(385,"sys.enum.unique.upsert","sys.attr.key")="sys.enum.unique.upsert"
^TBEnts(385,"sys.enum.unique.upsert","sys.attr.label")="Upsert @en"
^TBEnts(385,"sys.enum.unique.upsert","sys.attr.name")="upsert"
^TBEnts(500,"sys.type.cvt","sys.attr.alias")="CVT"
^TBEnts(500,"sys.type.cvt","sys.attr.description")="A meta-level concept type whose instances denote composite value types, where each grouping represents a single structured value, similar to a Freebase Compound Value Type. @en"
^TBEnts(500,"sys.type.cvt","sys.attr.example")="e.g. sys.cvt.height groups a magnitude field and a unit field as the fixed set of roles composing a height value @en"
^TBEnts(500,"sys.type.cvt","sys.attr.isa")="sys.type.type"
^TBEnts(500,"sys.type.cvt","sys.attr.key")="sys.type.cvt"
^TBEnts(500,"sys.type.cvt","sys.attr.label")="Composite Value Type @en"
^TBEnts(500,"sys.type.cvt","sys.attr.name")="cvt"
^TBEnts(500,"sys.type.cvt","sys.attr.notes")="Do not use sys.type.val for multi-field structured values, use sys.type.cvt instead. @en"
^TBEnts(500,"sys.type.cvt","sys.attr.usage")="Use this entity type to create composite value types when a value has multiple interrelated fields (e.g. a magnitude and a unit, or a value and a date) that must be captured together rather than as separate independent attributes. @en"
^TBEnts(700,"sys.type.type","sys.attr.alias")="TYPE"
^TBEnts(700,"sys.type.type","sys.attr.description")="A meta-level concept type whose instances denote foundational entity types in HermesBase, forming the cornerstone of HermesBase type system. @en"
^TBEnts(700,"sys.type.type","sys.attr.isa")="sys.type.type"
^TBEnts(700,"sys.type.type","sys.attr.key")="sys.type.type"
^TBEnts(700,"sys.type.type","sys.attr.label")="Type Type @en"
^TBEnts(700,"sys.type.type","sys.attr.name")="type"
^TBEnts(700,"sys.type.type","sys.attr.usage")="Use this entity type to create other fundamental entity types that are necessary for HermesBase to function @en"
^TBEnts(800,"sys.type.assoc","sys.attr.alias")="ASSOC"
^TBEnts(800,"sys.type.assoc","sys.attr.description")="A meta-level concept type whose instances denote relationship types that collectively describe objects, analogous to relations in the Relational Model. @en"
^TBEnts(800,"sys.type.assoc","sys.attr.isa")="sys.type.type"
^TBEnts(800,"sys.type.assoc","sys.attr.key")="sys.type.assoc"
^TBEnts(800,"sys.type.assoc","sys.attr.label")="Association Type @en"
^TBEnts(800,"sys.type.assoc","sys.attr.name")="assoc"
^TBEnts(800,"sys.type.assoc","sys.attr.usage")="Use this type to create association types for people, places, organizations, movies, and more. Use `sys.type.val` to create data types, Use `sys.type.enum` for enumerated types. @en"
^TBEnts(900,"sys.type.obj","sys.attr.alias")="OBJ"
^TBEnts(900,"sys.type.obj","sys.attr.description")="A meta-level concept type whose instances are objects. Each object is back-linked with one or more `associations` that collectively describe the object from various perspectives @en"
^TBEnts(900,"sys.type.obj","sys.attr.example")="e.g. an object to describe actor Tom Hanks. Objects in HermesBase are used to represent a wide range of topics, including people, places, events, books, movies, and more. Object is the specific instance of any topic within HermesBase. @en"
^TBEnts(900,"sys.type.obj","sys.attr.isa")="sys.type.type"
^TBEnts(900,"sys.type.obj","sys.attr.key")="sys.type.obj"
^TBEnts(900,"sys.type.obj","sys.attr.label")="Object Type @en"
^TBEnts(900,"sys.type.obj","sys.attr.name")="obj"
^TBEnts(900,"sys.type.obj","sys.attr.usage")="Associations are linked to an object with the `object` attribute. @en"
